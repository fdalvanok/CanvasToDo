# Copy this file to .env and fill in the values for local development.
# In GitHub Actions these are provided as repository secrets instead.

# Base URL of your Canvas instance, e.g. https://canvas.instructure.com
CANVAS_BASE_URL=

# Canvas API access token (Account > Settings > New Access Token)
CANVAS_TOKEN=

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Notion integration token (https://www.notion.so/my-integrations)
NOTION_TOKEN=

# Target Notion database ID (the destination for generated study scaffolds)
NOTION_DATABASE_ID=
